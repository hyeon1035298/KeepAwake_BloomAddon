                    { "box": [50, 6, 16, 31], "r": 3, "alpha": 0.05 },
                    { "box": [50, 6, 16, 31], "r": 3, "stroke": "ink", "alpha": 0.45 },
                    { "dot": [58, 12, 2], "fill": "accent" }
                  ]
                }
              }
            }

            { "value": "dark", "name": { "ko": "다크", "en": "Dark", "ja": "ダーク", "zh": "深色" } },
            { "value": "light", "name": { "ko": "라이트", "en": "Light", "ja": "ライト", "zh": "浅色" } }
          ],
          "name": { "ko": "테마", "en": "Theme", "ja": "テーマ", "zh": "主题" },
          "about": {
            "ko": "위젯과 창의 라이트·다크. Bloom 애드온으로 쓰면 Bloom의 테마를 따릅니다",
            "en": "Light or dark theme for the widget and window. When used as a Bloom add-on, it follows Bloom's theme",
            "ja": "ウィジェットとウィンドウのライト・ダークテーマ。Bloom アドオンとして使用する場合は Bloom のテーマに従います",
            "zh": "小组件与窗口的浅色或深色主题。作为 Bloom 插件使用时将跟随 Bloom 的主题"
          }
        },
        {
          "key": "pill.glass",
          "type": "bool",
          "default": true,
          "name": { "ko": "유리 효과", "en": "Glass effect", "ja": "ガラス効果", "zh": "玻璃效果" },
          "about": {
            "ko": "끄면 창이 블러 없이 테마 색으로 칠해집니다",
            "en": "When disabled, the window uses a solid theme color without blur",
            "ja": "オフにすると、ウィンドウはぼかしなしでテーマ色で塗りつぶされます",
            "zh": "关闭后窗口无模糊效果，直接填充主题色"
          }

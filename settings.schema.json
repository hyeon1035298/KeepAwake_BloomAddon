{
  "schema": 1,
  "groups": [
    {
      "id": "awake",
      "name": { "ko": "커피", "en": "Coffee" },
      "items": [
        {
          "key": "awake.display",
          "type": "choice",
          "default": "display",
          "options": [
            { "value": "display", "name": { "ko": "화면도 켜 두기", "en": "Keep the screen on too" } },
            { "value": "system", "name": { "ko": "시스템만 깨우기", "en": "Keep the system awake only" } }
          ],
          "name": { "ko": "깨우기 방식", "en": "Keep awake" },
          "about": {
            "ko": "켤 때 화면도 켜 둘지, 시스템만 깨어 있게 할지. 켜져 있는 동안 바꾸면 바로 적용됩니다",
            "en": "Whether the screen stays on too, or only the system stays awake. A change applies at once while on"
          }
        },
        {
          "key": "awake.duration",
          "type": "choice",
          "default": "always",
          "options": [
            { "value": "always", "name": { "ko": "끌 때까지", "en": "Until turned off" } },
            { "value": "m30", "name": { "ko": "30분", "en": "30 minutes" } },
            { "value": "h1", "name": { "ko": "1시간", "en": "1 hour" } },
            { "value": "h2", "name": { "ko": "2시간", "en": "2 hours" } },
            { "value": "custom", "name": { "ko": "직접 입력", "en": "Custom" } }
          ],
          "name": { "ko": "기본 시간", "en": "Default time" },
          "about": {
            "ko": "커피 아이콘을 오른쪽 클릭해 켤 때 얼마나 켜 둘지. 클릭하면 뜨는 창에서는 그때그때 고릅니다",
            "en": "How long a right-click on the cup keeps it on. The window a click opens picks a time for one session"
          }
        },
        {
          "key": "awake.minutes",
          "type": "int",
          "default": 45,
          "min": 1,
          "max": 1440,
          "name": { "ko": "직접 입력 시간(분)", "en": "Custom time (minutes)" },
          "about": {
            "ko": "기본 시간이 직접 입력일 때의 분. 창의 직접 입력 칸도 이 값에서 시작합니다",
            "en": "The minutes for a custom default time, and where the window's custom field starts"
          }
        }
      ]
    },
    {
      "id": "pill",
      "name": { "ko": "모양", "en": "Look" },
      "items": [
        {
          "key": "pill.theme",
          "type": "choice",
          "default": "system",
          "options": [
            { "value": "system", "name": { "ko": "Windows 작업표시줄 테마", "en": "Windows taskbar theme" } },
            { "value": "dark", "name": { "ko": "다크", "en": "Dark" } },
            { "value": "light", "name": { "ko": "라이트", "en": "Light" } }
          ],
          "name": { "ko": "테마", "en": "Theme" },
          "about": {
            "ko": "위젯과 창의 라이트·다크. Bloom 애드온으로 쓰면 Bloom의 테마를 따릅니다",
            "en": "Light or dark for the widget and its window. As a Bloom add-on it follows Bloom's theme"
          }
        },
        {
          "key": "pill.glass",
          "type": "bool",
          "default": true,
          "name": { "ko": "유리 효과", "en": "Glass effect" },
          "about": {
            "ko": "끄면 창이 블러 없이 테마 색으로 칠해집니다",
            "en": "When off, the window is filled in the theme's color without blur"
          }
        }
      ]
    }
  ]
}

            },
            {
              "value": "custom",
              "name": { "ko": "직접 입력", "en": "Custom", "ja": "カスタム", "zh": "自定义" },
              "easy": { "name": { "ko": "직접 정한 시간", "en": "Custom duration", "ja": "指定した時間", "zh": "自定义时长" } }
            }
          ],
          "name": { "ko": "기본 시간", "en": "Default duration", "ja": "標準の時間", "zh": "默认时长" },
          "about": {
            "ko": "커피 아이콘을 오른쪽 클릭해 켤 때 얼마나 켜 둘지. 클릭하면 뜨는 창에서는 그때그때 고릅니다",
            "en": "How long to stay on when turned on by right-clicking the coffee icon. You can pick any duration from the popup window on left-click",
            "ja": "コーヒーアイコンを右クリックしてオンにした時の持続時間です。クリックで開くウィンドウからはその都度選べます",
            "zh": "右键点击咖啡图标开启时的持续时间。左键点击弹出的窗口中可随时选择时长"
          },
          "easy": { "name": { "ko": "오른쪽 클릭으로 켜면", "en": "When turned on via right-click", "ja": "右クリックでオンにした時", "zh": "右键点击开启时" }, "about": "" }
        },
        {
          "key": "awake.minutes",
          "type": "int",
          "default": 45,
          "min": 1,
          "max": 1440,
          "name": { "ko": "직접 입력 시간(분)", "en": "Custom duration (min)", "ja": "カスタム時間 (分)", "zh": "自定义时长 (分钟)" },
          "about": {
            "ko": "기본 시간이 직접 입력일 때의 분. 창의 직접 입력 칸도 이 값에서 시작합니다",
            "en": "Minutes used when default duration is set to Custom. The custom input field in the window also starts with this value",
            "ja": "標準の時間がカスタムの時の分数です。ウィンドウのカスタム入力欄もこの値から始まります",
            "zh": "默认时长设为自定义时的分钟数。窗口中的自定义输入框也以此值为初始值"
          },
          "easy": {
            "name": { "ko": "직접 정한 시간", "en": "Custom duration", "ja": "指定した時間", "zh": "自定义时长" },
            "about": "",
            "when": { "key": "awake.duration", "is": "custom" },
            "minutes": true
          }
        }
